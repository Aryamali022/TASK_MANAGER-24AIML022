MONGO_URI=
PORT=5000
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Email (nodemailer). For Gmail: enable 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional, defaults to "Task Manager <SMTP_USER>"
# MAIL_FROM=

# Caching (node-cache). TTL in seconds; set CACHE_ENABLED=false to measure without the cache.
CACHE_TTL=60
CACHE_ENABLED=true

# Background notifications (EventEmitter). Fake delay in the task-created
# handler, and a switch that makes it throw to test the 'error' listener.
NOTIFY_DELAY_MS=2000
NOTIFY_SIMULATE_ERROR=false
